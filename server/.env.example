PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/pos-db
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=http://localhost:5173

# Required only when running `npm run seed` or `npm run create-admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password

# Optional demo accounts created by `npm run seed`.
DEMO_STAFF_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
